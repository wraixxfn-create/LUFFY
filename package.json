  "bugs": {
    "url": "https://github.com/wraixxfn-create/LUFFY/issues"
  },
  "homepage": "https://github.com/wraixxfn-create/LUFFY#readme",
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "vite": "^5.4.10"
  },
  "type": "module"
}