{
  "name": "luffy-3d",
  "version": "1.0.0",
  "description": "Procedural 3D character model of post-timeskip Monkey D. Luffy (One Piece) with a browser viewer and glTF export.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "export": "node tools/export-glb.mjs public/luffy.glb",
    "render": "node tools/render.js --out=renders",
    "model": "npm run export && npm run render"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wraixxfn-create/LUFFY.git"
  },
  "keywords": [],
